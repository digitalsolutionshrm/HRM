DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
# On Render, set DATABASE_URL to the PostgreSQL Internal Database URL instead.
DATABASE_URL=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

PORT=3000
# Set true only temporarily to initialize an empty database, then remove/disable it.
DB_SYNCHRONIZE=false
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BIOMETRIC_ENCRYPTION_KEY=

# Email notifications are opt-in. In-app notifications work when this is false.
NOTIFICATIONS_EMAIL_ENABLED=false
